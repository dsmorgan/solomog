apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: openai-realtime
  namespace: agentgateway-system
spec:
  parentRefs:
    - name: %%GATEWAY%%
      namespace: agentgateway-system
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /v1/realtime
      backendRefs:
        - name: openai-realtime
          group: enterpriseagentgateway.solo.io
          kind: EnterpriseAgentgatewayBackend
      # A realtime session is long-lived; do not let the default request timeout cut it.
      timeouts:
        request: "300s"
