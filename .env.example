# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
# Keep .env aligned with this template: `solomog env:sync` (rebuilds from here,
# overlaying your values). `solomog env:diff` shows key drift; `solomog env:backup`
# snapshots to .solomog/env-backups/ (also auto before aws/gcp refresh).
#
# Solo enterprise license keys.
#
# If all your products use the same key, set SOLO_LICENSE_KEY and leave the
# per-product keys blank. If different products need different keys, set the
# per-product keys — each one takes precedence over SOLO_LICENSE_KEY for that
# product. This lets you map a specific license to a specific application.

# Fallback key used by any product that has no product-specific key set.
SOLO_LICENSE_KEY=

# Per-product overrides (optional — leave blank to fall back to SOLO_LICENSE_KEY).
# NOTE: the ="" (not bare =) matters — see the dotenv gotcha below.
SOLO_ISTIO_LICENSE_KEY=""      # Solo managed Istio via Gloo Operator
GLOO_MESH_LICENSE_KEY=""       # Gloo Mesh Enterprise mgmt plane (optional product)
KGATEWAY_LICENSE_KEY=""        # enterprise kgateway (kgateway 2.2.x)
GLOO_GATEWAY_LICENSE_KEY=""    # Gloo Gateway (gloo-ee 1.21.x) — separate product
AGENTGATEWAY_LICENSE_KEY=""    # enterprise agentgateway (2.3.x)
KAGENT_LICENSE_KEY=""         # Solo Enterprise for kagent (separate entitlement)
PORTAL_LICENSE_KEY=""          # Solo Portal add-on (own entitlement; needs SEFK today)

# ─── Output / cosmetics ──────────────────────────────────────────────────────
# Mute the 🗿 mog banter (the intro/outro quips the `solomog` wrapper prints around a run).
# The wrapper reads this itself (it doesn't source .env like `task` does). Precedence:
# env prefix / inline var win over .env — all three forms work:
#   SOLOMOG_SERIOUS=1 solomog …    |    solomog … SOLOMOG_SERIOUS=1    |    this line in .env
# Only affirmatives (1/true/yes/on) mute; "" (or false/0) keeps the banter on.
SOLOMOG_SERIOUS=""             # 1/true/yes/on = quiet output; "" = 🗿 banter on

# ─── Monitoring add-on (`solomog monitoring`) ────────────────────────────────
# Grafana's admin password, read by helmfiles/addons/monitoring.yaml.gotmpl (grafana.adminPassword)
# and echoed by install-monitoring.sh in the "open Grafana" hint. Blank → the chart's default.
GRAFANA_ADMIN_PASSWORD=""      # default prom-operator (login is admin / <this>)

# ─── Upstream credentials for AI/MCP backends ────────────────────────────────
# Secrets a bundle materializes into the cluster (see bundles/ + the .sh hook
# example). Keep the VALUE here in .env (gitignored); the bundle script only
# references the env var, so the script itself carries no secret and is safe to
# commit. Auto-sourced by Taskfile (dotenv) and inherited by bundle scripts.
CLAUDE_API_KEY=""             # Anthropic API key for an agentgateway LLM backend
OPENAI_API_KEY=""             # OpenAI API key (if pointing at the real provider)
DEMO_SECRET=""                # bundles/example/20-demo-secret.sh — blank → demo-not-a-real-secret

# kagent's default ModelConfig. openAI uses OPENAI_API_KEY above; anthropic uses
# CLAUDE_API_KEY; ollama needs no key but must be reachable from the cluster.
KAGENT_PROVIDER=openAI         # openAI | anthropic | ollama
KAGENT_MODEL=""               # optional provider model override; "" = chart default
KAGENT_OLLAMA_HOST=""         # default: host.docker.internal:11434

# Enterprise kagent controller OIDC. Leave all blank for the bundled auto-IdP
# (single-cluster evaluation only). For a real IdP, set issuer + client credentials;
# SOLO_UI_OIDC_* separately configures the shared management UI clients.
KAGENT_OIDC_ISSUER=""
KAGENT_OIDC_CLIENT_ID=""       # default: kagent-enterprise
KAGENT_OIDC_CLIENT_SECRET=""

# GCP / Vertex AI. GCP_ACCESS_TOKEN is a short-lived (~1h) OAuth token from gcloud — do NOT
# paste one by hand; run `solomog gcp:refresh` to (re)fetch it into .env, then re-run
# your bundle to apply it. It's a general GCP identity token, not Vertex-specific.
# NOTE: the vertexai backend's projectId/region are currently LITERALS in
# bundles/llmroute-vertex/13-vertexai-EnterpriseAgentGatewayBackend.yaml (a plain .yaml, applied
# verbatim), so there is no env knob for them. Edit that file, or convert it to a .yaml.tmpl and
# add tokens to render() in scripts/apply-bundle.sh, if you need a different project/region.
GCP_ACCESS_TOKEN=""           # managed by `solomog gcp:refresh` (leave blank initially)

# AWS / Bedrock. The three AWS_* values are SHORT-LIVED SSO credentials — do NOT paste them
# by hand; run `solomog aws:refresh` to (re)fetch them into .env, then re-run your bundle.
# AWS_PROFILE selects which configured SSO profile aws:refresh exports (set it once after
# `aws configure sso`). AWS_SSO_SESSION names the SSO session for the login fallback (SOlo).
AWS_PROFILE=""                # e.g. solo-sso  (the profile `aws configure sso` created)
AWS_SSO_SESSION=""            # SSO session name (default: SOlo) — only used for sso-login
AWS_ACCESS_KEY_ID=""          # managed by `solomog aws:refresh` (leave blank initially)
AWS_SECRET_ACCESS_KEY=""      # managed by `solomog aws:refresh` (leave blank initially)
AWS_SESSION_TOKEN=""          # managed by `solomog aws:refresh` (leave blank initially)
# Region fallback. eks:create/eks:delete/eks:irsa prefer EKS_REGION and fall back to this
# (then us-east-1). It is also REQUIRED by the citizens-agentcore-user bundle's
# agentcore/redeploy.sh, which needs the AgentCore runtime's region explicitly.
AWS_REGION=""                 # e.g. us-east-1 — blank is fine unless you use agentcore/redeploy.sh

# Owner tag applied to EKS clusters `solomog eks:create` provisions (tag owner=<this>), so
# clusters are attributable in the shared AWS account. REPLACE with your email address.
OWNER=solomog                 # e.g. david.morgan@solo.io

# AWS Bedrock AgentCore runtime ARN — the Phase 0 MCP server (see
# bundles/private/citizens-260715/phase0-agentcore-mcp/). Consumed by the
# citizens-agentcore-rbac bundle's aws.agentCore backend + proxy-creds hooks. Get it from
# `agentcore deploy --json` / `agentcore status --json`. NOT a secret, but carries the account id.
AGENTCORE_RUNTIME_ARN=""      # e.g. arn:aws:bedrock-agentcore:us-east-1:170015905430:runtime/treasurymcp-xxxx
# A SECOND AgentCore MCP runtime (the PII/customer-records server, `custmcp`). The
# citizens-mcp-demo bundle relays to both — treasury-relay → ARN, customers-relay → ARN_2 — and
# 10-mcp-relay-backends.sh HARD-FAILS if either is unset. `solomog eks:irsa` also adds whichever
# of the two is set to the IRSA role's bedrock-agentcore resource list, so set it BEFORE eks:irsa
# or the proxy's SigV4 to the second runtime is denied.
AGENTCORE_RUNTIME_ARN_2=""    # e.g. arn:aws:bedrock-agentcore:us-east-1:170015905430:runtime/custmcp-xxxx

# ─── OBO token exchange (enterprise agentgateway STS) ────────────────────────
# TOKEN_EXCHANGE itself is CLI-ONLY — deliberately NOT settable here. It's a global,
# repo-wide dotenv value, not per-cluster, so persisting it would silently try to enable
# the STS on the NEXT agentgateway install on ANY cluster (even an unrelated one without
# Keycloak), crash-looping the controller. Pass it explicitly on the command that needs it:
#   solomog agentgateway CLUSTER=<cluster> TOKEN_EXCHANGE=true
# The two settings below ARE safe to persist — they're inert unless TOKEN_EXCHANGE=true is
# also passed on that same command.
# JWKS_URL is the IdP whose user tokens the STS validates (default: the in-cluster Keycloak
# from the OBO scenario). API_VALIDATOR=k8s suits the basic curl-driven OBO flow; set it to
# `remote` for the Solo UI's elicitation API. When remote, the apiValidator validates the UI's
# calls into the STS elicitation API. Per Solo's elicitation docs this is the SAME IdP JWKS as
# the subject validator (the UI, once wired to the IdP, signs its calls with IdP tokens) — so it
# DEFAULTS to TOKEN_EXCHANGE_JWKS_URL. Only set TOKEN_EXCHANGE_API_VALIDATOR_URL to override (e.g.
# the legacy autoauth keys http://solo-enterprise-ui...:5556/keys while the UI is still in dev mode).
TOKEN_EXCHANGE_JWKS_URL=""            # default: http://keycloak.keycloak.svc.cluster.local:8080/realms/obo-realm/protocol/openid-connect/certs
TOKEN_EXCHANGE_API_VALIDATOR=""       # k8s (default) | remote — use remote for Solo UI elicitation
TOKEN_EXCHANGE_API_VALIDATOR_URL=""   # blank → TOKEN_EXCHANGE_JWKS_URL; only set to override the remote validator's JWKS
# Elicitation (browser-consent OAuth to a SaaS, e.g. Snowflake). Both inert unless TOKEN_EXCHANGE=true.
# ELICITATION_SECRET is the GLOBAL fallback OAuth-provider secret the STS requires for elicitation
# (chart: tokenExchange.elicitation.secretName) — point it at the bundle's provider secret. CALLBACK_URL
# is the UI URL the browser returns to after consent; must match the secret's redirect_uri and the
# SaaS OAuth app's registered redirect.
TOKEN_EXCHANGE_ELICITATION_SECRET=""  # e.g. snowflake-elicitation (a Secret in agentgateway-system)
# CALLBACK_URL is CLUSTER-SPECIFIC. Leave BLANK and it derives from CLUSTER at install time:
#   https://ui.agw.<CLUSTER>.test/age/elicitations  (like OAUTH_ISSUER_HOST). Only set it to
# override for a non-default gateway/host — a value pinned here does NOT track the cluster, so
# installing on a different cluster would bake the wrong host into the control plane.
TOKEN_EXCHANGE_CALLBACK_URL=""

# ─── Okta (bundles/agw-okta-mcp — edge JWT validation) ───────────────────────
# Your Okta developer org + an "API Services" (machine-to-machine) app. OKTA_DOMAIN is the
# only value the applied config needs (the gateway just validates Okta's PUBLIC JWKS); the
# CLIENT_ID/SECRET/SCOPE are used ONLY by the bundle's tests to fetch a client-credentials
# token. The bundle assumes Okta's custom "default" authorization server (/oauth2/default).
# OKTA_SCOPE must be a scope your app is granted on that AS (create one, e.g. mcp.access).
OKTA_DOMAIN=""                        # org host, NO scheme (e.g. dev-1234567.okta.com)
OKTA_AUDIENCE=""                      # default: api://default (the default AS's audience)
OKTA_AUTH_SERVER_ID=""                # default: default (the custom "default" AS; used to build the eager-auth issuer URLs)
OKTA_CLIENT_ID=""                     # API Services app client id (tests only; ALSO the eager-auth pre-registered client — see below)
OKTA_CLIENT_SECRET=""                 # API Services app client secret (tests only; ALSO the eager-auth client secret)
OKTA_SCOPE=""                         # scope granted to the app on /oauth2/default (tests only)
# --- OBO / identity-propagation (Auth Code + PKCE user login) ---------------------------
# A SECOND Okta app: the user-facing OIDC client (Native = public/PKCE, or Web = confidential).
# Used by bundles/agw-okta-mcp/helpers/okta-pkce-login.sh to mint a real USER token (human sub).
OKTA_USER_CLIENT_ID=""                # the Native/Web OIDC app client id
OKTA_USER_CLIENT_SECRET=""            # set ONLY for a confidential Web app; leave blank for Native/public
OKTA_REDIRECT_URI=""                  # default http://localhost:8888/callback (must be registered on the app)
OKTA_USER_SCOPES=""                   # default "openid profile email mcp.access"
# ─── citizens-agentcore-user (private bundle) ────────────────────────────────────────────
# Okta + AWS Bedrock AgentCore + agentgateway: ONE user identity carried through an agent to an
# MCP server, enforced as user × agent tool RBAC. Reuses OKTA_DOMAIN / OKTA_CLIENT_ID /
# OKTA_USER_CLIENT_ID from the Okta block above (same org, same custom "default" AS).
# Keys are grouped by the bundle module that reads them. Blank = the module's documented default,
# EXCEPT where marked REQUIRED (those hard-fail `solomog apply`) or GATE (unset → module skips).
# See the bundle's README.md, VARIANTS.md, OKTA-SETUP.md and each module's header comment.
#
# --- Module 6 (54-obo-exchange.sh): OBO exchange via Okta's OWN RFC 8693 grant, on /downstream ---
# A CONFIDENTIAL Okta app used by the gateway to exchange the user's token for a downstream-
# scoped token. DISTINCT from the agentgateway-STS OBO above — this is Okta's native token-exchange
# grant. May reuse the API Services app's creds, BUT that app must have the **Token Exchange grant
# enabled** + **DPoP disabled**, and the default-AS access policy must allow the token-exchange
# grant + the requested scope (else unauthorized_client/access_denied). Must be a **Service (API
# Services)** app — Okta only supports Native(login)→Service(exchange).
OKTA_OBO_CLIENT_ID=""                 # blank → uses OKTA_CLIENT_ID (the API Services app)
OKTA_OBO_CLIENT_SECRET=""             # blank → uses OKTA_CLIENT_SECRET
#
# --- Edge / checkpoint ① (20-, 22-, 40-, 44-): the agent routes /agentuser-a|b|c ---
# One AgentCore runtime per agent, all deployed JWT-inbound (customJWTAuthorizer) from agentcore/.
# A and B run the ACTIVE edge-exchange variant (variant B in VARIANTS.md): the gateway performs a
# per-agent RFC 8693 exchange at checkpoint ①, so cid + narrowed scp identify the agent
# CRYPTOGRAPHICALLY. C is passthrough at the edge and exchanges INSIDE the runtime via AgentCore
# Identity — a different exchange engine feeding the same checkpoint-② enforcement point.
AGENT_A_RUNTIME_ARN=""                # REQUIRED — /agentuser-a, the trusted agent
AGENT_B_RUNTIME_ARN=""                # REQUIRED — /agentuser-b, the restricted agent
AGENT_C_RUNTIME_ARN=""                # REQUIRED by 22-agentuser-c-backend.sh (hard-fails apply if unset).
                                      #   Test 60 skips cleanly without it, but apply does NOT — see the
                                      #   note in VARIANTS.md "Agent C", which claims apply also skips.
AGENTCORE_AUDIENCE=""                 # default api://default — the expected + requested aud. MUST equal every
                                      #   runtime authorizer's allowedAudience or the invoke 403s.
AGENTUSER_A_GROUP=""                  # default llm-premium — group required to reach agent A (demo user HAS it)
AGENTUSER_B_GROUP=""                  # default llm-other — group required to reach agent B. The demo user HAS
                                      #   this one too, so BOTH agents are reachable and the TOOL RBAC is what
                                      #   differentiates them. Set to a group the user LACKS to restore an
                                      #   edge-containment 403 instead.
AGENTUSER_C_GROUP=""                  # default llm-premium — agent C is trusted (mirrors agent A)
AGENT_A_SCOPES=""                     # default "agentcore.invoke mcp.access sensitive.access" — the scopes A's
                                      #   exchange requests. MUST include MCP_SENSITIVE_SCOPE.
AGENT_B_SCOPES=""                     # default "agentcore.invoke mcp.access" — must NOT include it.
                                      #   Okta side: each OBO client's access-policy rule must GRANT its set.
#
# --- Module 7 (60-mcp-relay-backend.sh): the MCP server behind checkpoint ② (/mcp-tools) ---
# Reached through the gateway's MCP relay backend with JWT PASSTHROUGH — deploy it JWT-inbound with
# a customJWTAuthorizer, like the agents, from agentcore/mcptools. No SigV4 → any region works here
# (agentgateway-enterprise#7676 does not apply to this leg).
MCP_RUNTIME_ARN=""                    # REQUIRED — e.g. arn:aws:bedrock-agentcore:us-east-2:<acct>:runtime/mcptools-xxxx
MCP_SENSITIVE_TOOLS=""                # default transfer_funds,freeze_account (comma-separated Deny targets)
#
# --- Module 8 (64-, 66-): user × agent tool RBAC, and the per-agent cid proof ---
# The single /mcp-tools Deny rule permits a sensitive tool only when BOTH keys are present: the
# AGENT half (MCP_SENSITIVE_SCOPE ∈ jwt.scp, put there by the edge exchange) and the USER half
# (MCP_A_PRIVILEGED_GROUP ∈ jwt.groups). Okta's default-AS claim policy must keep `groups` on the
# EXCHANGED token, or the user half cannot be evaluated.
MCP_SENSITIVE_SCOPE=""                # default sensitive.access — must be in AGENT_A_SCOPES, NOT AGENT_B_SCOPES
MCP_A_PRIVILEGED_GROUP=""             # default llm-premium — the group the user must hold (demo user HAS it)
# Per-agent OBO API-Services apps: each is a Service app with the Token Exchange grant enabled +
# DPoP off, and its client id becomes the downstream `cid`. Agent A's access-policy rule must GRANT
# the sensitive scope; agent B's must NOT. Also drive /cid-verify-a|b (66-), which proves the
# composite through a DEDICATED relay: a route-level exchange DOES reach the upstream MCP server,
# but only when that relay carries no backend auth of its own — `auth.passthrough` re-injects the
# original token and silently shadows the exchange.
OKTA_OBO_CLIENT_ID_A=""               # agent A's OBO client id (→ cid on /cid-verify-a)
OKTA_OBO_CLIENT_SECRET_A=""
OKTA_OBO_CLIENT_ID_B=""               # agent B's OBO client id (→ cid on /cid-verify-b)
OKTA_OBO_CLIENT_SECRET_B=""
#
# --- Module 9 (68-mcp-crossas-exchange.sh): CHECKPOINT-② cross-AS exchange (/mcp-crossas) ---
# Reproduces a customer shape: the exchange runs on the MCP route ITSELF and targets a SECOND Okta
# authorization server (a "resource AS" owning that MCP domain), not the AS that issued the user
# token. Adds a new relay + route + policy; leaves modules 6/7/8 untouched.
# Okta PREREQ: RFC 8693 is single-AS BY DEFAULT — the resource AS must list the subject AS under
#   Security → API → <resource AS> → Trusted servers, define the scope, and carry an access-policy
#   rule permitting the OBO client for the token-exchange grant.
# AgentCore PREREQ: the exchanged token is resource-AS-issued, so the target runtime's
#   customJWTAuthorizer must TRUST that issuer — scaffold a dedicated runtime with
#   agentcore/scaffold-crossas-runtime.sh, then agentcore/redeploy.sh with AUTHORIZER_AS=<resource
#   AS id> and AGENTCORE_AUDIENCE=<its audience>. Pointing it at the default-AS runtime 403s.
MCP_API_AS_ID=""                      # GATE — the RESOURCE AS id (aus…) that performs the exchange.
                                      #   Unset → module 9 and test 62 skip cleanly.
MCP_API_AUDIENCE=""                   # default mcp-api-resource — the resource AS's audience
MCP_API_SCOPE=""                      # default mcp.invoke — a scope DEFINED on the resource AS
MCP_CROSSAS_RUNTIME_ARN=""            # blank → MCP_RUNTIME_ARN. Set to the runtime whose authorizer trusts
                                      #   the RESOURCE AS (the default-AS one will reject the exchanged token).
MCP_SUBJECT_AS=""                     # default "default" — the AS that ISSUED the inbound user token
CROSSAS_SUBJECT_AUDIENCE=""           # default api://default — that inbound token's aud, for jwtAuthentication

# ─── citizens-mcp-demo (private bundle) — two agents × two MCP runtimes ──────────────────
# The M2M-identity flavor: TWO AgentCore agents (demoagent1/demoagent2) each with its OWN Okta
# API-Services app, hairpinning through the gateway to TWO AgentCore MCP relays. The agents differ
# only by which clearance scope their Okta app is granted, which is what makes the tool filtering
# visible: agent 1 holds mcp.access + sensitive.access (both servers), agent 2 only mcp.access
# (treasury stricter, customers denied). Runtime ARNs come from AGENTCORE_RUNTIME_ARN{,_2} above.
# Both apps must be **Service (API Services)** apps on the custom "default" AS, with the
# client-credentials grant and their respective scopes granted by an access-policy rule.
# Consumed by agentcore/deploy-agents.sh, which HARD-FAILS on any of the four being unset.
OKTA_AGENT1_CLIENT_ID=""              # REQUIRED — demoagent1's API Services app (scopes: mcp.access sensitive.access)
OKTA_AGENT1_CLIENT_SECRET=""          # REQUIRED — its client secret
OKTA_AGENT2_CLIENT_ID=""              # REQUIRED — demoagent2's API Services app (scope: mcp.access only)
OKTA_AGENT2_CLIENT_SECRET=""          # REQUIRED — its client secret

# ─── citizens-mcp-demo2 (private bundle) — local mock harness, no AWS ────────────────────
# Proves the same user→agent containment primitives with in-cluster directResponse routes instead
# of real AgentCore backends, so it runs on a plain vind cluster. The gate policies are identical
# to the real bundle's; only the backendRef differs. Reuses OKTA_DOMAIN / OKTA_AUDIENCE above.
# Both pairs are group NAMES, and the demo's whole point is that the shared Okta user HOLDS the
# first of each pair and LACKS the second — so change them only together with the user's groups.
# 74-authz-policies.sh — edge authorization on jwt.groups, both directions on one identity:
MCPUSER_ALLOW_GROUP=""                # default llm-premium — group the user HAS  (/mcpuser-authz-allow → 200)
MCPUSER_DENY_GROUP=""                 # default mcpuser-admins — group the user LACKS (/mcpuser-authz-deny → 403)
# 84-mockagent-authz-response.sh — the same gate deciding WHICH AGENT ROUTE the user may reach:
MOCKAGENT_A_GROUP=""                  # default llm-premium — required for agent A (reachable)
MOCKAGENT_B_GROUP=""                  # default agent-b-users — required for agent B (denied)

# ─── Okta device-authorization-grant app (bundles/agw-okta-bedrock-llm) ─────────────────
# A THIRD Okta app ("App E" in the bundle's OKTA-SETUP.md): a public Native app with the
# Device Authorization grant enabled, used by the bundle's CLI token helper (no browser
# redirect listener needed — distinct from OKTA_USER_CLIENT_ID's PKCE app above). Reuses
# OKTA_DOMAIN/OKTA_AUDIENCE from the Okta block above (same org, same default AS). Also
# needs the bundle's `groups` claim on that AS — see OKTA-SETUP.md step 2 (not an env var;
# it's Okta-side config the gateway's CEL authorization rules read as `jwt.groups`).
OKTA_DEVICE_CLIENT_ID=""              # App E — Native app client id (Device Authorization grant, no secret)
OKTA_DEVICE_SCOPES=""                  # default "openid profile offline_access" (matches OKTA-SETUP.md step 4's access-policy scopes)
# Test knob for tests/40-ratelimit-premium.sh (also in agw-okta-bedrock-llm2): how many LARGE
# Bedrock calls to make while waiting for the premium 1k-tokens/min budget to 429. Each try is a
# real, billed Bedrock request — raise it only if the limiter isn't tripping.
RATELIMIT_TRIES=""                    # default 10

# ─── Solo UI OIDC (management chart — wire the UI to the SAME IdP as the MCP route) ──────
# Needed for browser-consent ELICITATION (e.g. Snowflake): the elicited SaaS token is keyed by
# the user's `sub`, so the UI must log the user in as the SAME identity as the MCP-request JWT.
# Otherwise the UI runs in dev "autoauth" mode and the token lands under the wrong identity.
# Inert unless SOLO_UI_OIDC_ISSUER is set (then the shared management release used by
# agentgateway UI / Enterprise kagent renders the OIDC block and leaves autoauth mode).
# Needs TWO Okta apps (App C = confidential Web, App D = SPA) —
# see bundles/agw-okta-mcp/OKTA-SETUP.md. Only ISSUER + the two client IDs shape config; the
# backend secret is injected inline (never committed). Also set TOKEN_EXCHANGE_API_VALIDATOR=remote
# (its URL then defaults to TOKEN_EXCHANGE_JWKS_URL — the same Okta JWKS).
SOLO_UI_OIDC_ISSUER=""                # e.g. https://integrator-5185242.okta.com/oauth2/default (matches the MCP-route JWT issuer)
SOLO_UI_OIDC_BACKEND_CLIENT_ID=""     # App C — confidential Web app client id
SOLO_UI_OIDC_BACKEND_CLIENT_SECRET="" # App C client secret (never committed)
SOLO_UI_OIDC_FRONTEND_CLIENT_ID=""    # App D — public SPA/PKCE app client id
SOLO_UI_OIDC_ADDITIONAL_SCOPES=""     # default ["profile","email"]  (add "groups" for group→role mapping)
SOLO_UI_OIDC_ROLE_MAPPER=""           # default ["global.Admin"] (PoV: all users admin); or a CEL claims.Groups mapper

# ─── Snowflake (bundles/agw-okta-mcp — elicitation OAuth backend) ─────────────
# From your Snowflake account + a custom OAuth security integration (see the bundle's
# SNOWFLAKE-SETUP runbook). The gateway does per-user browser OAuth consent (elicitation)
# against these and replays the resulting Snowflake token to the Snowflake MCP endpoint.
SNOWFLAKE_ACCOUNT_URL=""              # org URL, e.g. https://dimqfms-qy56216.snowflakecomputing.com
SNOWFLAKE_OAUTH_CLIENT_ID=""          # from SYSTEM$SHOW_OAUTH_CLIENT_SECRETS('AGW_MCP_OAUTH')
SNOWFLAKE_OAUTH_CLIENT_SECRET=""      # ditto (OAUTH_CLIENT_SECRET)
SNOWFLAKE_OAUTH_SCOPES=""             # default "session:role:AGW_ANALYST refresh_token" — Snowflake OAuth CUSTOM needs session:role:<ROLE>, NOT session:role-any (that's External OAuth)
SNOWFLAKE_MCP_DATABASE=""             # managed MCP server location — default: AGW_DEMO
SNOWFLAKE_MCP_SCHEMA=""               # default: PUBLIC
SNOWFLAKE_MCP_SERVER=""               # default: SNOWFLAKE_MCP

# ─── Eager-auth OAuth issuer (bundles/agw-atlassian-mcp) ─────────────────────
# The gateway becomes the OAuth Authorization Server MCP clients see (@ /oauth-issuer), doing
# "fake DCR" (returns a pre-registered Okta client) and brokering the auth-code flow to Okta.
# Enabled by a CLI-only flag on the install (NOT stored here, like TOKEN_EXCHANGE — enabling it
# on a cluster without the STS/config crash-loops the controller):
#     solomog agentgateway CLUSTER=<c> TOKEN_EXCHANGE=true OAUTH_ISSUER=true
# The eager-auth client must be a CONFIDENTIAL **Authorization Code** app with BOTH redirect URIs:
#     https://agw.<cluster>.test/oauth-issuer/callback/downstream
#     https://agw.<cluster>.test/oauth-issuer/callback/upstream
# This is NOT the API-Services (machine-to-machine) app OKTA_CLIENT_ID points at above — that grant
# can't do the browser flow. Simplest: create ONE dedicated Okta Web app (OIDC → Web Application →
# Authorization Code) with those two redirect URIs, and set it here. (Or reuse an existing confidential
# app, e.g. the Solo UI backend SOLO_UI_OIDC_BACKEND_*, by adding the two URIs to it.) Leave blank to
# fall back to OKTA_CLIENT_ID/SECRET (only correct if that IS a confidential Auth-Code app).
OAUTH_ISSUER_CLIENT_ID=""             # confidential Auth-Code app client id (the eager-auth downstream client)
OAUTH_ISSUER_CLIENT_SECRET=""         # its client secret (never committed)
# TOKEN_EXCHANGE_JWKS_URL must point at the Okta JWKS (https://<domain>/oauth2/<as-id>/v1/keys) for
# the STS subject/api validators. OAUTH_ISSUER_HOST defaults to agw.<cluster>.test.

# ─── Atlassian (bundles/agw-atlassian-mcp — Phase 2 target; per-user Jira/Confluence elicitation) ──
# Atlassian Jira/Confluence via mcp.atlassian.com. Atlassian's remote MCP uses Dynamic Client
# Registration, so there are NO client id/secret to set — the gateway registers itself dynamically
# (this is why it needs the eager-auth issuer above). All three below are OPTIONAL overrides. Needs
# a free Atlassian Cloud site (Jira/Confluence) to consent against. (Phase 1 of the bundle proves
# the eager-auth issuer against an in-cluster test MCP server and needs none of these.)
ATLASSIAN_BASE_URL=""                 # default https://mcp.atlassian.com (OAuth-discovery base)
ATLASSIAN_MCP_PATH=""                 # default /v1/mcp (StreamableHTTP); try /v1/mcp/authv2 if it 404s
ATLASSIAN_SCOPES=""                   # default "read:jira-work read:confluence-content.summary offline_access"

# ─── Okta Cross App Access / ID-JAG (bundles/private/citizens-agentcore-oktaxaa) ─────────
# Flavor 4. The gateway performs BOTH Cross App Access legs: leg 1 at Okta's ORG authorization
# server (the user's ID token → an Okta-signed ID-JAG assertion), leg 2 at an in-cluster resource
# AS (ID-JAG → the access token carrying `sub`=user + `act.sub`=agent). Tool RBAC then keys on
# that actor claim, so the SAME user gets different tools through agent A vs agent B.
# ⚠️ NONE of the OKTA_* apps above can be reused. XAA runs on the **org** AS (`/oauth2/v1`, issuer
# `https://<domain>` with no suffix), not the custom `/oauth2/default` one — so the exchange
# subject must be an ID TOKEN and the leg-1 client must be an Okta **AI Agent** object. Four new
# Okta objects are needed (one resource app, one shared login app, two AI Agents, plus a
# delegation + resource connection on each agent). Work through the bundle's OKTA-XAA-SETUP.md
# FIRST — enablement is Support-gated, not self-service, and the console shows ENABLED either way.
# Reuses OKTA_DOMAIN from the Okta block above. Blank below = the script's documented default.

# --- The three identities (the only genuinely required values) -----------------------------
# The AI Agents are the leg-1 clients and appear in `act.sub`; the login app is what the HUMAN
# signs into and becomes the edge JWT audience on all four routes. Different object types with
# different id prefixes — never name a login app after an agent (the Delegations table shows only
# the label, and a self-referential-looking row costs a real debugging round trip).
XAA_AGENT_A_CLIENT_ID=""              # REQUIRED. AI Agent A's client id (`wlp…`) — the trusted agent
XAA_AGENT_B_CLIENT_ID=""              # REQUIRED. AI Agent B's client id (`wlp…`) — the restricted one
XAA_LOGIN_CLIENT_ID=""                # the ONE OIDC Web app the user signs into (`0oa…`); shared by both agents

# --- Leg-1 client auth (how each AI Agent proves itself to Okta) ---------------------------
# PrivateKeyJwt is REQUIRED on the AI-Agents path: a registered agent authenticates with a
# client_assertion signed by its own key, never a secret. The PEM is shown ONCE when you generate
# the key pair — and the key starts INACTIVE, so activate it or leg 1 fails `invalid_client`.
# Got a JWK instead of a PEM? helpers/xaa-jwk-to-pem.sh converts it and prints the `kid`.
XAA_AGENT_AUTH=""                     # PrivateKeyJwt (needed for AI Agents) | ClientSecretBasic (default) | ClientSecretPost
XAA_AGENT_A_PRIVATE_KEY=""            # PEM path for agent A — required if XAA_AGENT_AUTH=PrivateKeyJwt
XAA_AGENT_B_PRIVATE_KEY=""            # PEM path for agent B — ditto
XAA_AGENT_A_CLIENT_SECRET=""          # only on the legacy app-to-app path (XAA_AGENT_AUTH != PrivateKeyJwt)
XAA_AGENT_B_CLIENT_SECRET=""          # ditto
XAA_AGENT_KEY_ALG=""                  # default RS256 | RS384 | RS512 | PS256 | ES256 | ES384
XAA_AGENT_KEY_KID=""                  # global default `kid` for the client_assertion (see the per-agent overrides)
XAA_AGENT_A_KEY_KID=""                # agent A's `kid`; blank → XAA_AGENT_KEY_KID. Set only if the agent has >1 key
XAA_AGENT_B_KEY_KID=""                # agent B's `kid`. A wrong kid and a key belonging to another client report identically

# --- The user login (helpers/xaa-login.sh — ONE browser sign-in, cached) -------------------
# Mints the user's Okta ID token once and caches it to .solomog/xaa-id-token.json; every test and
# both agent routes reuse it. `groups` is requested but Okta CANNOT put it in an ID-JAG (org-AS
# rule) — the resource AS resolves entitlements instead, see the entitlements block below.
XAA_LOGIN_CLIENT_SECRET=""            # the login app's secret (confidential Web app)
XAA_LOGIN_PRIVATE_KEY=""              # PEM path instead, if the login app uses private_key_jwt
XAA_LOGIN_KEY_KID=""                  # its `kid` — only needed when that app has more than one registered key
XAA_REDIRECT_URI=""                   # default http://localhost:8899/callback — must be registered on the login app
XAA_LOGIN_SCOPES=""                   # default "openid profile email groups"

# --- Hardened two-login-app shape (optional) -----------------------------------------------
# Default is ONE shared login app, matching the sibling flavors' "one user, two agents" story. Set
# the A and B ids to DIFFERENT Okta apps and each route audience-binds to its own app, so agent A's
# ID token is cryptographically rejected at agent B's route (tests/30 re-arms itself and proves it).
# The cost of the shared default: the route is then the only agent selector at checkpoint 1.
XAA_AGENT_A_LOGIN_CLIENT_ID=""        # per-agent edge audience for A; blank → XAA_LOGIN_CLIENT_ID
XAA_AGENT_A_LOGIN_CLIENT_SECRET=""    # its secret; blank → XAA_AGENT_A_CLIENT_SECRET, then XAA_LOGIN_CLIENT_SECRET
XAA_AGENT_A_LOGIN_PRIVATE_KEY=""      # or a PEM path; blank → XAA_LOGIN_PRIVATE_KEY
XAA_AGENT_B_LOGIN_CLIENT_ID=""        # per-agent edge audience for B; blank → XAA_LOGIN_CLIENT_ID
XAA_AGENT_B_LOGIN_CLIENT_SECRET=""    # as above for B
XAA_AGENT_B_LOGIN_PRIVATE_KEY=""      # as above for B

# --- Leg 2: the in-cluster resource authorization server -----------------------------------
# Okta plays leg 1 only; leg 2 belongs to the resource's own AS, which we run in-cluster
# (src/resource_as.py) so we control the final token's claims and can stamp a real `act`.
# 🔴 XAA_RESOURCE_AS_ISSUER is the highest-risk value in the whole setup: it becomes the ID-JAG's
# `aud`, and the AS rejects any assertion whose aud is not itself. Okta's "Issuer URL" field, the
# policy's crossAppAccess.audience, and this var are THREE COPIES of one string — byte for byte, no
# trailing slash. Okta never dereferences it, so an in-cluster .svc.cluster.local issuer is fine.
XAA_RESOURCE_CLIENT_ID=""             # leg-2 client id — ours to choose. default xaa-resource-client
XAA_RESOURCE_CLIENT_SECRET=""         # blank → generated once and kept in the Secret
XAA_RESOURCE_AS_ISSUER=""             # default https://oktaxaa-resource-as.oktaxaa.svc.cluster.local
XAA_RESOURCE_API=""                   # Okta's "Resource URL" + the final token's aud. default https://treasury.xaa.test/mcp
XAA_SEND_RESOURCE=""                  # default false — Okta answers invalid_target on the RFC 8707 `resource` param

# --- Scopes and the actor claim ------------------------------------------------------------
# Agent scopes need NO Okta config: the org AS holds no custom scopes, it just asserts the strings
# into the ID-JAG and the resource AS grants the INTERSECTION. That is also why B's ceiling is
# gateway/resource-enforced rather than IdP-governed unless the agent's connection sets a policy.
XAA_AGENT_A_SCOPES=""                 # default "treasury.read treasury.write" (A may use the sensitive tool)
XAA_AGENT_B_SCOPES=""                 # default "treasury.read" — must NOT include the sensitive scope
XAA_SENSITIVE_SCOPE=""                # default treasury.write — the scope tests/20 asserts A has and B lacks
XAA_ACT_MODE=""                       # propagate (default) = Okta's nested act chain, so act.sub is the AI Agent's id;
                                      #   synthesize = flatten to the per-connection resource-side alias
XAA_ACT_CLAIM=""                      # act.sub (default, standards-pure) | act_sub (flat fallback if CEL traversal fails)
XAA_AGENT_A_RESOURCE_CLIENT_ID=""     # A's resource-side alias; blank → its AI Agent id. Only read when ACT_MODE=synthesize
XAA_AGENT_B_RESOURCE_CLIENT_ID=""     # B's — must DIFFER from A's or the A/B act.sub comparison collapses
XAA_CLIENT_AUTH_METHOD=""             # leg-2 client auth: ClientSecretBasic (default) | ClientSecretPost
XAA_EXCHANGE_CACHE_TTL=""             # default 5m — how long the gateway caches the exchanged composite

# --- Entitlements, resolved resource-side (because Okta cannot carry `groups`) -------------
# VERIFIED: the org AS supports no claim mappings and rejects scope=groups, so there is no ID-JAG
# with a groups claim. The resource AS keys off the ID-JAG's `email` instead, and stamps which rule
# fired as `groups_source` in the token. A real deployment points this at the entitlement store it
# already trusts; these knobs are the demo's stand-in for it.
XAA_PRIVILEGED_USERS=""               # emails (or subs) granted XAA_PRIVILEGED_GROUP — comma/space separated
XAA_PRIVILEGED_GROUP=""               # default llm-premium — the group the RBAC requires for sensitive tools
XAA_DEFAULT_GROUPS=""                 # default llm-basic — what everyone else gets
XAA_ENTITLEMENTS=""                   # raw JSON map, overrides the two above: {"a@x.test":["llm-premium"],"*":["llm-basic"]}
XAA_USER_GROUPS_FALLBACK=""           # grants the SAME groups to EVERYONE — bring-up shortcut only; it makes the
                                      #   user half of the RBAC decorative, and reports groups_source=fallback to say so

# --- Tool RBAC and leg-2 hardening ---------------------------------------------------------
# A denied tool is filtered out of tools/list AND returns HTTP 400 `-32602 Unknown tool`, which
# tears down an MCP SDK session — that is working as designed, not a bug.
XAA_SENSITIVE_TOOLS=""                # default transfer_funds,freeze_account — comma-separated Deny targets (54-tools-rbac.sh)
XAA_SENSITIVE_TOOL=""                 # SINGULAR, and distinct from the above: the ONE tool tests 40/50 assert the
                                      #   permit/deny pair on. default transfer_funds — keep it inside XAA_SENSITIVE_TOOLS
XAA_ALLOWED_ACTORS=""                 # permitted ID-JAG client_id values; blank → both agents. Set it and an unknown
                                      #   actor can never reach act.sub
XAA_STRICT_IDJAG_TYP=""               # default true — require header typ=oauth-id-jag+jwt
XAA_IDJAG_MAX_AGE_SECONDS=""          # default 30 — reject a stale-but-unexpired assertion (replay containment)
