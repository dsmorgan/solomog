# Add-on: Solo UI / management plane for agentgateway (the `management` chart).
#
# This is the UI half of the `solomog agentgateway:ui` scenario. The Solo UI is a
# singleton `management` chart with per-product toggles. This sync enables
# agentgateway and reuses existing values so Enterprise kagent can share the
# same release without a second owner for the bundled management CRDs.
#
#   ENTERPRISE ONLY. The Solo UI is an enterprise feature; there is no community
#   equivalent. The install script guards EDITION=community before reaching here.
#
# CRDs: the `management-crds` subchart is bundled inside `management` and enabled
# by default — we let the chart own them (the official 2.3.x install path). The
# workshop's separate management-crds release + `enabled=false` is the Helm CRD-
# lifecycle pattern for long-lived mgmt clusters; it buys nothing for ephemeral
# vclusters, so we skip it.
#
# License: management_license_key. KAGENT_LICENSE_KEY wins when present (the
# documented shared-release upgrade path); otherwise agentgateway/generic.
# Tracing wiring (EnterpriseAgentgatewayPolicy) is applied by install-agentgateway-ui.sh
# after this sync, since it targets the Gateway created by `solomog expose`.
#
# Verified: https://docs.solo.io/agentgateway/2.3.x/install/ui/setup/

bases:
  - ../commons.yaml

---

{{- $preserveOIDC := eq (env "MANAGEMENT_PRESERVE_OIDC") "true" }}
{{- /* UI_OIDC=false (CLI-only, from the agentgateway:ui task) forces the bundled dev IdP
       even when SOLO_UI_OIDC_* is populated in .env. The case it exists for: .env points at
       a real Okta org whose app has no redirect URI for this cluster's host, so Okta answers
       400 and the UI never loads. Throwaway clusters get a new host every time, so demanding
       an Okta app edit per cluster is the wrong trade. */ -}}
{{- $uiOIDC := ne (env "UI_OIDC") "false" }}

repositories:
  - name: solo-enterprise
    url: "{{ .Values.helm_repo_solo_enterprise }}"
    oci: true

releases:
  - name: management
    namespace: agentgateway-system
    chart: solo-enterprise/management
    version: "{{ .Values.management_version }}"
    wait: true
    reuseValues: true
    values:
      - cluster: "{{ env "SOLO_CLUSTER" | default "mgmt-cluster" }}"
        licensing:
          licenseKey: "{{ .Values.management_license_key }}"
        global:
          imagePullPolicy: IfNotPresent
        service:
          type: ClusterIP
        products:
          # Do not render false entries for other products: reuseValues preserves
          # kagent if it was enabled on this singleton release.
          agentgateway:
            enabled: true
            namespace: agentgateway-system
            features:
              # Off by default in the chart, which hides the whole Cost Management
              # section — Dashboard, Model Cost Catalog, Budgets, Dimensions and the
              # admin-only Virtual Keys page that issues API keys. solomog turns it on
              # because those pages are the point of an LLM gateway demo. Spend is
              # computed from tracing spans, so the tracing policy applied by
              # install-agentgateway-ui.sh is a hard prerequisite, and prices need a
              # model cost catalog on the Gateway or spend stays 0.
              #   Ref: https://docs.solo.io/agentgateway/kubernetes/2026.7.1/documentation/llm/cost-controls/dashboard/#enable
              # Unquoted on purpose: these must reach the chart as YAML booleans. Quoted,
              # COST_MANAGEMENT=false would render the STRING "false", which is non-empty
              # and therefore truthy in a Go template `if` — the toggle would silently
              # never turn anything off.
              cost-management: {{ env "COST_MANAGEMENT" | default "true" }}
              # Set COST_MANAGEMENT_WRITES=false for a read-only Cost Management
              # section: the UI can then display budgets, dimensions and virtual keys
              # but not create or edit them. Useful for showing what a locked-down
              # operator view looks like.
              cost-management-writes: {{ env "COST_MANAGEMENT_WRITES" | default "true" }}
        clickhouse:
          enabled: true
        tracing:
          verbose: true
{{- /* OIDC: wire the UI to a real IdP (e.g. Okta) instead of the bundled dev "autoauth" IdP
       (image solo-enterprise-autoauth). Opt-in — the block renders ONLY when SOLO_UI_OIDC_ISSUER
       is set, so the default install stays in autoauth mode, untouched. The chart has no explicit
       autoauth on/off toggle; setting oidc.issuer is what switches it to real OIDC.
       WHY THIS MATTERS FOR ELICITATION: browser-consent (elicitation) stores the SaaS token keyed
       by the user's `sub`. If the UI logs the user in via autoauth, that sub != the Okta sub on the
       MCP-request JWT, so the elicited token is never found on replay. The UI must authenticate the
       user as the SAME IdP identity as the MCP route — hence issuer = the same Okta default AS as
       the route JWT + the STS apiValidator (see products/agentgateway.yaml.gotmpl). Two Okta apps:
       a confidential Web app (backend) and a public SPA (frontend) — see bundles/agw-okta-mcp/OKTA-SETUP.md.
       Client secret comes from .env (SOLO_UI_OIDC_BACKEND_CLIENT_SECRET), injected inline like the
       license key — never committed. */ -}}
{{- if and (not $preserveOIDC) $uiOIDC (env "SOLO_UI_OIDC_ISSUER") }}
        oidc:
          issuer: "{{ env "SOLO_UI_OIDC_ISSUER" }}"
          additionalScopes: {{ env "SOLO_UI_OIDC_ADDITIONAL_SCOPES" | default "[\"profile\",\"email\"]" }}
        rbac:
          roleMapping:
            # PoV default: grant every authenticated user global.Admin (a bare CEL list literal, so
            # it ignores claims). For group-based roles instead, add a Groups claim in Okta + set
            # SOLO_UI_OIDC_ROLE_MAPPER to the chart default "claims.Groups.transformList(...)".
            roleMapper: '{{ env "SOLO_UI_OIDC_ROLE_MAPPER" | default "[\"global.Admin\"]" }}'
        ui:
          backend:
            oidc:
              clientId: "{{ env "SOLO_UI_OIDC_BACKEND_CLIENT_ID" }}"
              # Inline secret from .env → the chart CREATES a Secret named `secretRef`
              # (its default `ui-backend-oidc-secret`) holding it, and the ui-backend mounts
              # that name. Do NOT set secretRef:"" — it's the mount NAME, not a toggle; empty
              # makes the chart create/mount a Secret named "" (resource name may not be empty).
              secret: "{{ env "SOLO_UI_OIDC_BACKEND_CLIENT_SECRET" }}"
              secretKey: clientSecret
          frontend:
            oidc:
              clientId: "{{ env "SOLO_UI_OIDC_FRONTEND_CLIENT_ID" }}"
{{- else if and (not $preserveOIDC) (not $uiOIDC) }}
        # UI_OIDC=false. Two non-obvious things make this block necessary and make it look
        # the way it does.
        #
        # 1. Simply not rendering the OIDC block does NOT undo a previous OIDC install.
        #    `reuseValues: true` means `helm upgrade --reuse-values`, which uses the PREVIOUS
        #    release's computed values as the base, so the old Okta issuer survives.
        #
        # 2. `null` does not delete it either. Under --reuse-values a null reads as "no value
        #    supplied" rather than "remove this key". It is worse than a no-op: it is recorded
        #    in the user-supplied values, so `helm get values` prints `oidc: null` and the
        #    change looks applied, while `helm get values --all` still shows the Okta issuer
        #    and the UI keeps redirecting there.
        #
        # An empty STRING is what actually overrides it. The chart keys the autoauth-vs-real
        # decision off a non-empty `oidc.issuer`, so blanking it returns OIDC_ISSUER to the
        # bundled dev IdP at solo-enterprise-ui:5556. Verified by `helm upgrade --dry-run`.
        #
        # Only these three keys: `ui.backend.oidc.secret` and `.secretRef` are deliberately
        # left alone, since secretRef is a mount NAME and blanking it makes the chart mount a
        # Secret named "" (a hard failure). Guarded by `not $preserveOIDC` so this can never
        # strip OIDC that Enterprise kagent shares on this same singleton release.
        oidc:
          issuer: ""
        ui:
          backend:
            oidc:
              clientId: ""
          frontend:
            oidc:
              clientId: ""
{{- end }}
