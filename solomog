#!/usr/bin/env bash
# solomog — thin wrapper around task that always runs from the solomog repo root.
# Symlink this to ~/.local/bin/solomog (done by: bash scripts/setup.sh).
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cd "$SCRIPT_DIR"

if ! command -v task &>/dev/null; then
  echo "solomog: 'task' (go-task) is not installed yet." >&2
  echo "Bootstrap prerequisites first:  bash \"$SCRIPT_DIR/scripts/setup.sh\"" >&2
  exit 127
fi

# 🗿 mog bookends + per-task timing. The wrapper runs each requested task in turn,
# times it, and prints ONE summary at the end listing each task's run time plus the
# grand total — so a chained run (`solomog a b c`) shows a clean per-task breakdown
# instead of scattered mini-summaries. Per-task progress framing (step delimiters)
# still lives in the scripts.
source "$SCRIPT_DIR/scripts/lib/ui.sh"
# shellcheck source=scripts/lib/validate.sh
source "$SCRIPT_DIR/scripts/lib/validate.sh"

# Audit log: one compact line per run, in a monthly-rotated file beside the test runs
# (.solomog/audit/YYYY-MM.log — gitignored). Records timestamp, ok/FAIL, exit code, total
# time, and the command with secret-looking var VALUES redacted. Best-effort: never fails
# the run. Populated from TASKS/VARS/AUDIT_TASKS/SECONDS set below.
AUDIT_TASKS=()
_solomog_audit() {
  local rc="$1" status dir month v name cmd line red=()
  [ "$rc" = "0" ] && status=ok || status=FAIL
  dir="$SCRIPT_DIR/.solomog/audit"
  month="$(date +%Y-%m 2>/dev/null)" || return 0
  mkdir -p "$dir" 2>/dev/null || return 0
  for v in "${VARS[@]}"; do
    name="${v%%=*}"
    case "$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')" in
      *KEY*|*TOKEN*|*SECRET*|*PASSWORD*|*PASS*) red+=("${name}=***") ;;
      *) red+=("$v") ;;
    esac
  done
  cmd="$(printf '%s ' "${TASKS[@]}" "${red[@]}")"; cmd="${cmd% }"
  line="$(date +%Y-%m-%dT%H:%M:%S%z)  ${status}  rc=${rc}  dur=${SECONDS}s  ${cmd}"
  [ "${#AUDIT_TASKS[@]}" -gt 1 ] && line="${line}  [${AUDIT_TASKS[*]}]"
  printf '%s\n' "$line" >> "$dir/${month}.log" 2>/dev/null || true
}

# Bare `solomog` (no args) → grouped index, no framing (not audited).
if [ $# -eq 0 ]; then
  exec bash "$SCRIPT_DIR/scripts/list.sh"
fi

# `solomog help [topic...]` → grouped index, a group/prefix page, --all, or
# per-task --summary. Meta command: no mog framing, not audited. `task --summary`
# appends resolved `vars:`/`env:` (license keys, tokens); help.sh strips that
# trailer. Summaries use "Variables:" (never a bare "vars:"/"env:" line).
if [ "$1" = "help" ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  shift
  # shellcheck source=scripts/lib/help.sh
  source "$SCRIPT_DIR/scripts/lib/help.sh"
  if [ $# -eq 0 ]; then
    solomog_help_index
    exit 0
  fi
  solomog_help_dispatch "$@"
  exit $?
fi

# `solomog agentcore:env ...` → shell-eval-able exports. Meta command: no mog framing, not
# audited, because the framing/summary printf's go to STDOUT and would land inside the user's
# `eval "$(solomog agentcore:env NAME=x)"`. Passed straight through to go-task (-s: no
# "task: [x] cmd" echo either), so stdout stays pure shell. Its own human output is on stderr.
if [ "$1" = "agentcore:env" ]; then
  shift
  exec task -s agentcore:env "$@"
fi

# Pick removal-themed banter when a teardown/delete is in the run.
MOG_MODE=""
for arg in "$@"; do
  case "$arg" in
    teardown|delete|*:delete) MOG_MODE=destroy; break ;;
  esac
done

# Split args into task names and KEY=VALUE globals. The globals apply to every task;
# task names use ':' not '=', so '=' is a safe delimiter to partition on.
TASKS=(); VARS=()
for a in "$@"; do
  case "$a" in
    *=*) VARS+=("$a") ;;
    *)   TASKS+=("$a") ;;
  esac
done

# Tasks that consume the FULL CLUSTER/CLUSTERS list (internal loop or mesh orchestration).
# Everything else is single-cluster and takes only the first name — see Taskfile alias
# contract. Keep in sync when adding a new multi-cluster task.
_solomog_task_takes_cluster_list() {
  case "$1" in
    istio:ambient:multi-*|istio:sidecar:multi-*) return 0 ;;
    net:repair|teardown|delete|vind:delete|eks:delete) return 0 ;;
    vsphere:stop|vsphere:start|vsphere:snapshot|vsphere:reset|vsphere:delete) return 0 ;;
    *) return 1 ;;
  esac
}

# Warn when CLUSTER(S) has multiple names but one or more tasks in the run are
# single-cluster (they silently use only the first name). Mesh/teardown/etc. keep
# the full list — this is not wrapper fan-out. Soft warning only; never fails the run.
_solomog_warn_cluster_list_slip() {
  local cluster_val="" clusters_val="" val first t singles=""
  for t in "${VARS[@]}"; do
    case "$t" in
      CLUSTER=*)  cluster_val="${t#CLUSTER=}" ;;
      CLUSTERS=*) clusters_val="${t#CLUSTERS=}" ;;
    esac
  done
  val="$clusters_val"
  [ -z "$val" ] && val="$cluster_val"
  case "$cluster_val" in *" "*) val="$cluster_val" ;; esac
  case "$clusters_val" in *" "*) val="$clusters_val" ;; esac
  case "$val" in
    *" "*) ;;
    *) return 0 ;;
  esac
  # Word-count via set — bash 3.2 safe (no mapfile).
  # shellcheck disable=SC2086
  set -- $val
  [ $# -ge 2 ] || return 0
  first="$1"
  singles=""
  for t in "${TASKS[@]}"; do
    if ! _solomog_task_takes_cluster_list "$t"; then
      singles="${singles:+$singles }$t"
    fi
  done
  [ -n "$singles" ] || return 0
  {
    echo "Warning: CLUSTER(S)=\"${val}\" names $# clusters, but single-cluster task(s) only use the first ('${first}'): ${singles}"
    echo "  Multi-cluster mesh/teardown/net:repair keep the full list; expose/apps/apply do not fan out."
    echo "  To repeat a single-cluster chain on each:  for c in ${val}; do solomog ${singles} CLUSTER=\$c; done"
  } >&2
}

# Resolve the 🗿 banter mute flag (SOLOMOG_SERIOUS). The banter is the wrapper's own
# output, but the wrapper — unlike `task` — does NOT source .env, so read the flag here.
# All three forms work, in precedence order:
#   1. environment / inline CLI var:  SOLOMOG_SERIOUS=1 solomog …   or   solomog … SOLOMOG_SERIOUS=1
#   2. .env:  SOLOMOG_SERIOUS=1
# Only affirmatives (1/true/yes/on) mute — see _solomog_truthy in ui.sh.
for _a in "$@"; do
  case "$_a" in SOLOMOG_SERIOUS=*) SOLOMOG_SERIOUS="${_a#*=}" ;; esac
done
if [ -z "${SOLOMOG_SERIOUS:-}" ] && [ -f "$SCRIPT_DIR/.env" ]; then
  _sm_v="$(sed -n 's/^[[:space:]]*SOLOMOG_SERIOUS[[:space:]]*=[[:space:]]*//p' "$SCRIPT_DIR/.env" | tail -n1)"
  _sm_v="${_sm_v%%#*}"                          # drop any trailing inline comment
  _sm_v="${_sm_v%"${_sm_v##*[![:space:]]}"}"    # rtrim
  _sm_v="${_sm_v#\"}"; _sm_v="${_sm_v%\"}"      # strip surrounding double quotes
  _sm_v="${_sm_v#\'}"; _sm_v="${_sm_v%\'}"      # …or single quotes
  SOLOMOG_SERIOUS="$_sm_v"; unset _sm_v
fi
export SOLOMOG_SERIOUS

# Reject unknown tasks and unknown KEY= names before any task runs (and before
# the 🗿 bookends). A typo mid-chain used to fail only when that token's turn
# arrived — after earlier installs had already completed.
if ! solomog_validate_cli; then
  exit 1
fi

solomog_intro "$MOG_MODE"
solomog_clock_reset   # grand-total clock (this process; task subprocesses don't touch it)

# Only globals, no task names → defer to task unchanged (e.g. it picks the default).
if [ ${#TASKS[@]} -eq 0 ]; then
  task "$@"; rc=$?
  _solomog_audit "$rc"
  solomog_outro "$rc" "$MOG_MODE"
  exit $rc
fi

_solomog_warn_cluster_list_slip

rc=0
TASK_TIMES=()
for t in "${TASKS[@]}"; do
  t_start=$SECONDS
  if [ ${#VARS[@]} -gt 0 ]; then task "$t" "${VARS[@]}"; else task "$t"; fi
  trc=$?
  t_dur=$((SECONDS - t_start))
  if [ "$trc" -eq 0 ]; then
    TASK_TIMES+=("$t  —  $(solomog_dur "$t_dur")")
    AUDIT_TASKS+=("${t}=${t_dur}s")
  else
    TASK_TIMES+=("$t  —  $(solomog_dur "$t_dur")  (FAILED, exit $trc)")
    AUDIT_TASKS+=("${t}=${t_dur}s(rc${trc})")
    rc=$trc
    break   # stop the chain on first failure
  fi
done

solomog_summary "Run complete — ${#TASK_TIMES[@]} task(s)" "${TASK_TIMES[@]}"
_solomog_audit "$rc"
solomog_outro "$rc" "$MOG_MODE"
exit $rc
